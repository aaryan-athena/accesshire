rules_version = '2';

// Shared by the AccessHire portal and the employer intake form (form/).
// Deploy with:  firebase deploy --only firestore:rules --project form-data-0365
service cloud.firestore {
  match /databases/{database}/documents {

    // Employer submissions. Public read: every listing is shown on the portal.
    // Anyone can submit (the intake form has no sign-in); only the posting
    // employer can change or remove a role posted from the portal.
    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['companyName', 'jobs'])
                    && request.resource.data.jobs is list;
      allow update, delete: if request.auth != null
                            && resource.data.employerId == request.auth.uid;
    }

    // Account profile + saved jobs + interests: owner only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Candidate capability + access profile: private to the candidate.
    match /candidate_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
